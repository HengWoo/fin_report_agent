      "good": {"net_margin_min": 8, "prime_cost_max": 62, "description": "Above-average performance"},
      "fair": {"net_margin_min": 5, "prime_cost_max": 65, "description": "Average performance"},
      "poor": {"net_margin_max": 5, "prime_cost_min": 65, "description": "Below-average performance"}
    }
  },

