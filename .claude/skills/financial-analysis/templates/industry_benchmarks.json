  "restaurant": {
    "industry_name": "Restaurant / Food & Beverage",
    "industry_code": "restaurant",
    "chinese_name": "餐饮业",

    "revenue_composition": {
      "food_revenue_pct": {"min": 60, "max": 75, "ideal": 65, "unit": "%", "description": "Food sales as % of total revenue"},
      "beverage_revenue_pct": {"min": 25, "max": 40, "ideal": 35, "unit": "%", "description": "Beverage sales as % of total revenue"}
    },

    "cost_benchmarks": {
      "food_cost_pct": {"min": 28, "max": 35, "ideal": 30, "unit": "%", "description": "Food cost as % of food revenue", "chinese": "食品成本率"},
      "beverage_cost_pct": {"min": 20, "max": 30, "ideal": 25, "unit": "%", "description": "Beverage cost as % of beverage revenue", "chinese": "酒水成本率"},
