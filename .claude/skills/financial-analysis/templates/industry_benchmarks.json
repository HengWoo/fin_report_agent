    "labor_benchmarks": {
      "labor_cost_pct": {"min": 25, "max": 35, "ideal": 30, "unit": "%", "description": "Total labor cost as % of revenue", "chinese": "人工成本率"}
    },

    "operating_expense_benchmarks": {
      "rent_pct": {"min": 5, "max": 10, "ideal": 8, "unit": "%", "description": "Rent as % of revenue", "chinese": "租金占比"},
