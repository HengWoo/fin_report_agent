      "marketing_pct": {"min": 2, "max": 5, "ideal": 3, "unit": "%", "description": "Marketing expense as % of revenue", "chinese": "营销费用占比"},
      "total_opex_pct": {"min": 15, "max": 25, "ideal": 20, "unit": "%", "description": "Total operating expenses as % of revenue", "chinese": "营业费用率"}
    },

    "profitability_benchmarks": {
      "gross_margin": {"min": 60, "max": 70, "ideal": 65, "unit": "%", "description": "Gross profit margin", "chinese": "毛利率"},
      "operating_margin": {"min": 10, "max": 20, "ideal": 15, "unit": "%", "description": "Operating profit margin", "chinese": "营业利润率"},
      "net_margin": {"min": 5, "max": 15, "ideal": 10, "unit": "%", "description": "Net profit margin", "chinese": "净利润率"}
